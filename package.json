{
  "name": "dsh-next-reply-chips",
  "version": "0.6.1",
  "description": "在每条回答下方显示最多 3 个可点击的下一步建议：建议由主回复自身给出、不额外调用模型，点击可立即发送或只填入输入框。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon-180.png",
    "preview-light.png",
    "preview-dark.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "icon": "./icon-180.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web",
    "ui",
    "suggestions",
    "next-reply",
    "下一步建议"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Charlieeeo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charlieeeo/dsh-next-reply-chips.git"
  },
  "homepage": "https://github.com/Charlieeeo/dsh-next-reply-chips#readme",
  "bugs": {
    "url": "https://github.com/Charlieeeo/dsh-next-reply-chips/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT"
}
