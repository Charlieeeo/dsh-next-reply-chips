{
  "name": "dsh-next-reply-chips",
  "version": "0.5.0",
  "description": "Clickable next-reply chips under every assistant turn in DeepSeek Harness: the reply itself carries up to three suggested next messages, so no auxiliary model call is spent, and a click either fills the composer or sends immediately.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web",
    "ui",
    "suggestions",
    "next-reply",
    "下一步建议"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Charlieeeo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charlieeeo/dsh-next-reply-chips.git"
  },
  "homepage": "https://github.com/Charlieeeo/dsh-next-reply-chips#readme",
  "bugs": {
    "url": "https://github.com/Charlieeeo/dsh-next-reply-chips/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT"
}
